# BookTrack — Apache settings
Options -Indexes
AddDefaultCharset UTF-8
DirectoryIndex index.php

# Startup warnings happen before application error handling (e.g. oversized POSTs).
# Log them rather than sending output before cookies/status headers can be set.
<IfModule php_module>
  php_flag display_errors Off
  php_flag display_startup_errors Off
  php_flag log_errors On
</IfModule>

# Friendly "page not found" for any missing page inside BookTrack
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Work out the folder BookTrack lives in (e.g. /booktrack-v2), so this works under any folder name
  RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
  RewriteRule .* - [E=BT_BASE:%1]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule .? %{ENV:BT_BASE}/404.php [L]
</IfModule>

# Never serve hidden folders such as .git (the whole source history) or .github
<IfModule mod_alias.c>
  RedirectMatch 404 "/\.(git|github)(/|$)"
</IfModule>

# Never serve these files directly
<FilesMatch "^(config\.php|config\.local\.php|config\.local\.example\.php|config\.production\.example\.php|.*\.sql|.*\.sqlite|.*\.md|.*\.log|.*\.yml)$">
  Require all denied
</FilesMatch>

AddType font/woff2 .woff2
AddType application/javascript .mjs

# ES module imports have stable URLs; always revalidate them after code changes.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
